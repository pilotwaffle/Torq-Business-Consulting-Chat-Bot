# TORQ Chat — environment template
# Copy to .env for local development.

# ---------------------------------------------------------------------------
# Client (Vite) — safe to expose in the browser bundle
# ---------------------------------------------------------------------------
# Base URL of the TORQ Chat BFF (Backend-for-Frontend).
VITE_TORQ_API_BASE=http://localhost:8787

# ---------------------------------------------------------------------------
# Server only — DO NOT put these in the Vite client / do NOT prefix with VITE_
# ---------------------------------------------------------------------------
# Anthropic API key is held by the BFF (server on port 8787), never bundled
# into the web client. Configure it in the server's own .env, for example:
#   ANTHROPIC_API_KEY=sk-ant-api03-…
#
# Get a Console key: https://console.anthropic.com/settings/keys
