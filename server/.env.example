# TORQ Chat BFF — copy to .env and fill in real values.
# NEVER commit .env. NEVER put real secrets in source.

# Required: Anthropic API key (server-side only; never sent to the browser)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required in production: secret used to sign session JWTs (HS256).
# Use a long random string (32+ bytes). In development a random secret is
# generated if this is unset (sessions will not survive restarts).
SESSION_SECRET=change-me-to-a-long-random-secret

# HTTP port (default 8787)
PORT=8787

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: soft global daily token budget (input+output). Exceeding returns 429.
# DAILY_TOKEN_BUDGET=500000
