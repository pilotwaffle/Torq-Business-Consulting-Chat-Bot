# Dependencies & build output (rebuilt in image)
node_modules
dist

# Env / secrets — never bake into the image
.env
.env.*
!.env.example

# Tests & tooling (not needed at runtime)
tests
vitest.config.ts
coverage
*.test.ts
*.spec.ts

# Git / IDE / docs
.git
.gitignore
.vscode
.idea
*.md
!README.md

# Logs & OS junk
logs
*.log
.DS_Store
Thumbs.db
npm-debug.log*
